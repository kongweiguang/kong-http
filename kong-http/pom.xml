<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kongweiguang</groupId>
        <artifactId>kong</artifactId>
        <version>1.1</version>
    </parent>

    <artifactId>kong-http</artifactId>
    <version>1.0</version>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <okhttp.version>4.12.0</okhttp.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.kongweiguang</groupId>
            <artifactId>kong-core</artifactId>
            <version>1.0</version>
        </dependency>

        <dependency>
            <groupId>io.github.kongweiguang</groupId>
            <artifactId>kong-json</artifactId>
            <version>1.0</version>
        </dependency>

        <!--okhttp依赖-->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!--sse依赖-->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!--日志添加-->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>logging-interceptor</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- 1. 项目基本信息 -->
    <name>kong-http</name>
    <description>kong-http 是一个基于 OkHttp 的轻量 HTTP 客户端封装，使用链式 API 完成请求构建。</description>
    <url>https://github.com/kongweiguang/kong-http</url>

    <!-- 2. 开源许可声明 -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 3. 开发者信息 -->
    <developers>
        <developer>
            <name>kongweiguang</name>
            <email>240524885@qq.com</email>
            <organization>https://github.com/kongweiguang</organization>
            <organizationUrl>https://github.com/kongweiguang</organizationUrl>
        </developer>
    </developers>

    <!-- 4. 源码控制信息 -->
    <scm>
        <connection>scm:git:https://github.com</connection>
        <developerConnection>scm:git:ssh://github.com:kongweiguang/kong-http.git</developerConnection>
        <url>https://github.com/kongweiguang/kong-http</url>
    </scm>
</project>
